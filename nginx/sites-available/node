server {
    listen 0.0.0.0:443 ssl;
    listen 0.0.0.0:80;

    server_name .node;

    include conf.d/host_resolver;

    root $_root;

    access_log /var/log/nginx/access.node.$_install_dir.log main;
    error_log /var/log/nginx/error.node.log error;

    location / {
        proxy_pass http://unix:$_base_path/$_install_dir/node.sock;
        include conf.d/proxy_params;
    }

    client_max_body_size 6m;
}
